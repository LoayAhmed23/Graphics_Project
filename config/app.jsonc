                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "car_frame",
                    "sampler": "default"
                },
                "highway":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "highway",
                    "sampler": "default"
                },
                "monkey": {
                    "type": "lit", 
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "albedo": "monkey_albedo",
                    "specular": "monkey_specular",
                    "roughness": "monkey_roughness",
                    "emission": "monkey_emission",
                    "sampler": "default",
                    
                    "albedoTint": [1.0, 0.0, 1.0],
                    "specularStrength": 1.0,
                    "roughnessValue": 1.0,
                    "emissionTint": [1.0, 1.0, 1.0]
                },
                "moon":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "moon",
                    "sampler": "default"
                }
            }
        },
